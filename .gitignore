# data & checkpoints — too large for git
# (data/* rather than data/ so the KEMAR exception below can apply — git does
# not descend into fully-ignored directories)
data/*
!data/kemar/
checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# Claude
CLAUDE.md

# MuJoCo
MUJOCO_LOG.TXT
*.xml.bak

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# SLURM
slurm/logs/*
!slurm/logs/.gitkeep
slurm/env.local.sh

# Experiment outputs
results/
wandb/
runs/
*.sif

# Python venv
.venv/
venv/
