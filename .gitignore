# data & checkpoints — too large for git
# (data/* rather than data/ so the KEMAR exception below can apply — git does
# not descend into fully-ignored directories)
data/*
!data/kemar/
checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# Claude
CLAUDE.md
.claude/

# MuJoCo
MUJOCO_LOG.TXT
*.xml.bak

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# SLURM
slurm/logs/*
!slurm/logs/.gitkeep
slurm/env.local.sh

# Experiment outputs — but keep the small eval summaries: they are the evidence
# behind the write-ups and must be version-controlled (results*/* rather than
# results*/ so git descends far enough for the exceptions to apply)
results*/*
!results/eval_summary.json
!results_smoke/eval_summary.json
!results_rl_smoke/eval_summary.json
wandb/
runs/
*.sif

# Python venv
.venv/
venv/
